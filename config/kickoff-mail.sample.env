# Copia estos valores en Vercel → Settings → Environment Variables (Production)
# No subas contraseñas al repositorio.

# --- Opción A: Private Email (Namecheap) — recomendada si ya usas hi@raulyn.com ---
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hi@raulyn.com
SMTP_PASS=tu_contraseña_del_buzón
SMTP_FROM=Casa Creativa Kickoff <hi@raulyn.com>

# Destinatarios al enviar el formulario (coma separada)
KICKOFF_NOTIFY_EMAILS=hi@raulyn.com,sucasacreativa@gmail.com,isusanarincond@gmail.com

# --- Opción B: Resend (alternativa) ---
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Casa Creativa Kickoff <kickoff@raulyn.com>